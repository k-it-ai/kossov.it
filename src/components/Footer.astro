---
import { link, useT } from '../i18n';
interface Props { lang: 'en' | 'de' | 'ru' }
const { lang } = Astro.props;
const t = useT(lang);
---

<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-4 py-8 text-sm text-gray-500 sm:flex-row sm:justify-between sm:px-6 lg:px-8">
    <p>&copy; <span data-year>{new Date().getFullYear()}</span> kossov.it. {t('footer.copyright')}</p>
    <a href={link(lang, '/privacy/')} class="hover:text-gray-800 hover:underline">{t('footer.legal')}</a>
  </div>
</footer>

<script>
  // Keep the copyright year current even if the site is not rebuilt for a while.
  document.querySelectorAll('[data-year]').forEach((el) => (el.textContent = String(new Date().getFullYear())));
</script>
