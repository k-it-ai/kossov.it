---
import { useT } from '../i18n';
import { services, cardOrder } from '../data/services.js';

interface Props { lang: 'en' | 'de' | 'ru' }
const t = useT(Astro.props.lang);
const byKey = Object.fromEntries(services.map((s) => [s.key, s]));
---

<section id="services" class="scroll-mt-16 overflow-hidden bg-white pt-8 pb-16 sm:pt-12 sm:pb-24" data-globe-area>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-semibold text-brand-red">{t('services.eyebrow')}</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-balance text-ink sm:text-4xl">{t('services.title')}</h2>
      <p class="mt-6 text-lg leading-8 text-gray-600">{t('services.intro')}</p>
    </div>

    <!-- Globe with the six topics as labelled pills around it (pills from laptop width up) -->
    <div class="relative mt-8 flex items-center justify-center py-8 sm:mt-12">
      {services.map((s, i) => (
        <div class:list={['svc-pill absolute z-10 hidden lg:block', `svc-pos-${i}`]}>
          <a href={`#svc-${s.key}`} tabindex="-1" aria-hidden="true" data-pill class="inline-flex items-center gap-2.5 rounded-full bg-white py-1.5 pr-4 pl-1.5 text-sm font-semibold whitespace-nowrap text-ink shadow-[0_6px_24px_rgba(42,126,180,0.16)] ring-1 ring-gray-200/80 pill-link">
            <span class:list={['flex h-8 w-8 items-center justify-center rounded-full bg-linear-160', s.gradient]}>
              <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6" aria-hidden="true" class="h-[18px] w-[18px]">
                <path stroke-linecap="round" stroke-linejoin="round" d={s.icon}></path>
              </svg>
            </span>
            {t(`services.items.${s.key}.title`)}
          </a>
        </div>
      ))}

      <div class="pointer-events-none z-0 h-[260px] w-full sm:h-[340px] md:h-[454px]" data-globe></div>
    </div>

    <!-- The same six topics, readable on every device -->
    <ul class="mx-auto mt-12 grid max-w-5xl gap-x-10 gap-y-10 sm:mt-16 sm:grid-cols-2 lg:grid-cols-3">
      {cardOrder.map((key) => (
        <li id={`svc-${key}`} class="svc-card -m-3 flex scroll-mt-28 gap-4 rounded-2xl p-3" data-card>
          <span class:list={['flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-linear-160 shadow-sm', byKey[key].gradient]}>
            <svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.5" aria-hidden="true" class="h-6 w-6">
              <path stroke-linecap="round" stroke-linejoin="round" d={byKey[key].icon}></path>
            </svg>
          </span>
          <div>
            <h3 class="font-semibold text-ink">{t(`services.items.${key}.title`)}</h3>
            <p class="mt-1 leading-7 text-gray-600">{t(`services.items.${key}.text`)}</p>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex justify-center sm:mt-16">
      <a href="#contact" class="btn-primary">{t('services.cta')}</a>
    </div>
  </div>
</section>

<script>
  import { mountGlobe } from '../scripts/globe.js';
  const container = document.querySelector('[data-globe]');
  const area = document.querySelector('[data-globe-area]');
  if (container && area) mountGlobe(container, area);

  // Pills jump to their card below and highlight it briefly.
  document.querySelectorAll<HTMLAnchorElement>('[data-pill]').forEach((pill) =>
    pill.addEventListener('click', (e) => {
      const card = document.querySelector<HTMLElement>(pill.getAttribute('href')!);
      if (!card) return;
      e.preventDefault();
      card.scrollIntoView({ behavior: 'smooth', block: 'center' });
      card.classList.remove('is-highlighted');
      void card.offsetWidth;
      card.classList.add('is-highlighted');
      setTimeout(() => card.classList.remove('is-highlighted'), 2200);
    }),
  );
</script>
