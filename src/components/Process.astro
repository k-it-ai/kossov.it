---
import { Image, Picture } from 'astro:assets';
import { useT } from '../i18n';
import talk from '../assets/process/feedback.png';
import inspect from '../assets/process/design.png';
import done from '../assets/process/code.png';
import topography from '../assets/process/topography.png';

interface Props { lang: 'en' | 'de' | 'ru' }
const t = useT(Astro.props.lang);

// Three steps, all visible at once: talk → take stock → look after.
const steps = [talk, inspect, done].map((image, i) => ({
  image,
  label: t(`process.steps.${i}.label`),
  title: t(`process.steps.${i}.title`),
  text: t(`process.steps.${i}.text`),
}));
---

<section id="process" class="relative scroll-mt-16 overflow-hidden bg-night py-16 sm:py-24">
  <div class="relative z-10 mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-balance text-white sm:text-4xl">{t('process.title')}</h2>
      <p class="mt-4 text-lg leading-8 text-gray-300">{t('process.intro')}</p>
    </div>

    <ol class="mx-auto mt-12 grid max-w-2xl gap-6 sm:mt-16 lg:max-w-none lg:grid-cols-3 lg:gap-6">
      {steps.map((s, i) => (
        <li class="relative grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-3 rounded-2xl bg-[#202020] p-5 ring-1 ring-white/10 lg:flex lg:flex-col lg:gap-0 lg:p-8 lg:text-center">
          <Image src={s.image} alt="" width={128} densities={[1, 2]} loading="lazy" class="h-16 w-16 object-contain lg:h-32 lg:w-32" />
          <div>
            <p class="text-sm font-semibold tracking-wide text-brand-cyan uppercase lg:mt-6">{s.label}</p>
            <h3 class="mt-0.5 text-lg leading-snug font-semibold text-white lg:mt-1">{s.title}</h3>
          </div>
          <p class="col-span-2 leading-7 text-gray-300 lg:mt-2">{s.text}</p>

          {i < steps.length - 1 && (
            <span class="absolute bottom-0 left-1/2 z-10 flex h-8 w-8 -translate-x-1/2 translate-y-[calc(50%+0.75rem)] items-center justify-center rounded-full bg-night text-brand-cyan ring-1 ring-white/15 lg:top-1/2 lg:right-0 lg:bottom-auto lg:left-auto lg:h-9 lg:w-9 lg:translate-x-[calc(50%+0.75rem)] lg:-translate-y-1/2" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 rotate-90 lg:rotate-0"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"></path></svg>
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>

  <Picture
    src={topography}
    alt=""
    formats={['avif', 'webp']}
    widths={[430, 860]}
    sizes="50vw"
    loading="lazy"
    class="pointer-events-none absolute bottom-0 left-0 z-0 h-auto w-1/2 -scale-x-100 opacity-50"
  />
</section>
