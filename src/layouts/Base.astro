---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { LANGS, SITE, asset, urlFor, useT } from '../i18n';

interface Props {
  lang: 'en' | 'de' | 'ru';
  /** Path without language prefix, e.g. '/' or '/privacy/'. */
  path: string;
  title: string;
  description: string;
  keywords?: string[];
  locale?: string;
  noindex?: boolean;
  /** Send first-time visitors to their browser language (English homepage only). */
  langRedirect?: boolean;
}

const { lang, path, title, description, keywords, locale = 'en_US', noindex = false, langRedirect = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const t = useT(lang);
const canonical = urlFor(lang, path);


---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Private site: reachable by link, but not listed in search engines or used by AI. -->
    <meta name="robots" content="noindex, nofollow, noarchive, noai, noimageai" />
    <!-- Opt out of text & data mining / AI training (W3C TDM Reservation Protocol) -->
    <meta name="tdm-reservation" content="1" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l, path)} />)}
    <link rel="alternate" hreflang="x-default" href={urlFor('en', path)} />

    <link rel="icon" href={asset('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="kossov.it" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="kossov.it logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@kossov_it" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-image.png`} />

    <Font cssVariable="--font-source-sans" preload={[{ subset: lang === 'ru' ? 'cyrillic' : 'latin' }]} />
    {langRedirect && (
      <script is:inline define:vars={{ base }}>
        // First visit to the English homepage: switch to the browser's language (de/ru).
        // An explicit choice in the language menu is remembered and always wins.
        try {
          var saved = localStorage.getItem('lang');
          var prefs = saved ? [saved] : (navigator.languages || [navigator.language]);
          var target = prefs.map(function (l) { return String(l).slice(0, 2).toLowerCase(); })
            .find(function (l) { return l === 'en' || l === 'de' || l === 'ru'; });
          if (target && target !== 'en') location.replace(base + '/' + target + '/' + location.hash);
        } catch (e) {}
      </script>
    )}
    <slot name="head" />
  </head>
  <body class="font-sans">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink focus:shadow-lg"
    >
      {t('a11y.skip')}
    </a>
    <Header lang={lang} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Contact lang={lang} />
    <Footer lang={lang} />
  </body>
</html>
